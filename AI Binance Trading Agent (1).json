      "id": "6131812d-609b-4294-a979-4db12b3be87b",
      "name": "Place Sell Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1792,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "9WwO7ZIQwqseGNcB",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst sellOrder = $input.first().json;\nconst preSell = $('Compute Sell Signature').first().json;\nconst openPos = preSell.state.openPosition;\n\nconst fills = sellOrder.fills || [];\nconst exitPrice = fills.length > 0\n  ? parseFloat(fills[0].price)\n  : parseFloat(sellOrder.cummulativeQuoteQty) / parseFloat(sellOrder.executedQty);\nconst entryPrice = parseFloat(openPos.entry_price);\nconst quantity = parseFloat(openPos.quantity || sellOrder.executedQty);\nconst pnl = (exitPrice - entryPrice) * quantity;\nconst now = new Date().toISOString();\nconst today = now.split('T')[0];\n\nreturn [{\n  json: {\n    originalOrderId: openPos.order_id,\n    exitPrice: exitPrice.toFixed(4),\n    pnl: pnl.toFixed(4),\n    pnlNumber: pnl,\n    symbol: openPos.symbol,\n    quantity: openPos.quantity,\n    entryPrice: openPos.entry_price,\n    aiReason: openPos.ai_reason || '',\n    closeReason: preSell.state.closeReason,\n    exitTime: now,\n    today,\n    todayPnl: (preSell.state.todayPnl || 0) + pnl,\n    tradeCount: (preSell.state.tradeCount || 0) + 1,\n  }\n}];\n      "
      },
      "id": "6b8cb88d-c42c-43c9-9876-60fec4bf5602",
      "name": "Prepare Close Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ]
