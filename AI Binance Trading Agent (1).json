    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst data = $input.first().json;\nconst openPos = data.state.openPosition;\nconst symbol = openPos.symbol;\nconst quantity = openPos.quantity;\nconst apiSecret = data.apiSecret;\nconst timestamp = Date.now();\nconst qs = 'symbol=' + symbol + '&side=SELL&type=MARKET&quantity=' + quantity + '&timestamp=' + timestamp;\nconst signature = crypto.createHmac('sha256', apiSecret).update(qs).digest('hex');\nreturn [{\n  json: {\n    ...data,\n    sellRequest: { symbol, side: 'SELL', type: 'MARKET', quantity, timestamp, signature },\n  }\n}];\n      "
      },
      "id": "82e3a628-a75b-4d71-b250-aaf69a3989db",
      "name": "Compute Sell Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.binance.com/api/v3/order",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ { symbol: $json.sellRequest.symbol, side: $json.sellRequest.side, type: $json.sellRequest.type, quantity: $json.sellRequest.quantity, timestamp: $json.sellRequest.timestamp, signature: $json.sellRequest.signature } }}",
        "options": {}
