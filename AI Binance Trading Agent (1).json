      "id": "61f83210-30cf-4842-94bc-545fa3b9aa73",
      "name": "Get Daily Stats",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        672,
        96
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Trading Config').first().json;\nconst openPosItems = $('Get Open Position').all();\nconst statsItems = $('Get Daily Stats').all();\n\nconst openPos = openPosItems.find(i => i.json && i.json.status === 'OPEN' && i.json.symbol);\nconst statsRow = statsItems.find(i => i.json && i.json.trade_date);\n\nconst todayPnl = statsRow ? parseFloat(statsRow.json.total_pnl) || 0 : 0;\nconst tradeCount = statsRow ? parseInt(statsRow.json.trade_count) || 0 : 0;\nconst dailyLossLimit = parseFloat(cfg.dailyLossLimitUSDT) || 3;\nconst hasOpenPosition = !!openPos;\nconst dailyLossBreached = todayPnl <= -Math.abs(dailyLossLimit);\n\nreturn [{\n  json: {\n    shouldContinue: !dailyLossBreached,\n    hasOpenPosition,\n    dailyLossBreached,\n    todayPnl,\n    tradeCount,\n    openPosition: openPos ? openPos.json : null,\n    apiSecret: cfg.apiSecret,\n    cryptoPanicToken: cfg.cryptoPanicToken,\n    tradeBudgetUSDT: parseFloat(cfg.tradeBudgetUSDT) || 12,\n    stopLossPct: parseFloat(cfg.stopLossPct) || 3,\n    takeProfitPct: parseFloat(cfg.takeProfitPct) || 5,\n    dailyLossLimitUSDT: dailyLossLimit,\n  }\n}];\n      "
      },
