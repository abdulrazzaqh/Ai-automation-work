    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst data = $input.first().json;\nconst decision = data.decision;\nconst symbol = decision.symbol;\nconst tradeBudget = data.tradeBudgetUSDT;\nconst apiSecret = data.apiSecret;\nconst timestamp = Date.now();\n// quoteOrderQty = spend exactly this many USDT\nconst budgetStr = tradeBudget.toFixed(2);\nconst qs = 'symbol=' + symbol + '&side=BUY&type=MARKET&quoteOrderQty=' + budgetStr + '&timestamp=' + timestamp;\nconst signature = crypto.createHmac('sha256', apiSecret).update(qs).digest('hex');\nreturn [{\n  json: {\n    ...data,\n    buyRequest: { symbol, side: 'BUY', type: 'MARKET', quoteOrderQty: budgetStr, timestamp, signature },\n  }\n}];\n      "
      },
      "id": "81958613-4c2b-4a64-a2b8-208ce09031f0",
      "name": "Compute Buy Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.binance.com/api/v3/order",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ { symbol: $json.buyRequest.symbol, side: $json.buyRequest.side, type: $json.buyRequest.type, quoteOrderQty: $json.buyRequest.quoteOrderQty, timestamp: $json.buyRequest.timestamp, signature: $json.buyRequest.signature } }}",
        "options": {}
      },
      "id": "bc596796-02b6-4185-94c7-eb16ab0bd381",
      "name": "Place Buy Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2016,
        192
      ],
      "credentials": {
        "httpHeaderAuth": {
