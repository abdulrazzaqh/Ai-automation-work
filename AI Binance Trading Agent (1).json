    },
    {
      "parameters": {
        "jsCode": "\nconst orderResult = $input.first().json;\nconst buyData = $('Compute Buy Signature').first().json;\nconst decision = buyData.decision;\nconst stopLossPct = buyData.stopLossPct;\nconst takeProfitPct = buyData.takeProfitPct;\n\nconst fills = orderResult.fills || [];\nconst fillPrice = fills.length > 0\n  ? parseFloat(fills[0].price)\n  : parseFloat((buyData.markets[decision.symbol] && buyData.markets[decision.symbol].currentPrice) || 0);\nconst quantity = orderResult.executedQty;\nconst now = new Date().toISOString();\n\nconst stopLoss = fillPrice * (1 - stopLossPct / 100);\nconst takeProfit = fillPrice * (1 + takeProfitPct / 100);\n\nreturn [{\n  json: {\n    symbol: decision.symbol,\n    side: 'BUY',\n    orderId: String(orderResult.orderId),\n    entryPrice: fillPrice.toFixed(4),\n    quantity: String(quantity),\n    stopLoss: stopLoss.toFixed(4),\n    takeProfit: takeProfit.toFixed(4),\n    aiReason: decision.reason,\n    confidence: decision.confidence,\n    entryTime: now,\n  }\n}];\n      "
      },
