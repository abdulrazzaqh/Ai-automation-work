              "value": "={{ \"<h2>⚠️ AI Binance Trading Agent — Error Alert</h2><p><strong>Time:</strong> \" + $now.setZone(\"Asia/Karachi\").toFormat(\"yyyy-MM-dd HH:mm:ss\") + \" (PKT)</p><table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;width:100%;font-family:monospace'><tr><td><strong>Workflow</strong></td><td>\" + $json.workflow.name + \"</td></tr><tr><td><strong>Execution ID</strong></td><td>\" + $json.execution.id + \"</td></tr><tr><td><strong>Failed Node</strong></td><td>\" + $json.execution.lastNodeExecuted + \"</td></tr><tr><td><strong>Error Message</strong></td><td style='color:red'>\" + $json.error.message + \"</td></tr><tr><td><strong>Mode</strong></td><td>\" + $json.execution.mode + \"</td></tr></table><br><p>Please check your n8n instance for more details.</p><p style='color:orange'><strong>Note:</strong> The trading agent has paused for this cycle. It will retry automatically on the next 15-minute schedule.</p>\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
