              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are scoring a B2B lead against an ICP.\\n\\nICP: {{ $json.icpDescription }}\\n\\nLead profile:\\nName: {{ $json.fullName }}\\nTitle: {{ $json.title }}\\nCompany: {{ $json.companyName }}\\nCompany size: {{ $json.companySize }}\\nIndustry: {{ $json.companyIndustry }}\\nHeadline: {{ $json.headline }}\\n\\nRespond ONLY with JSON, no markdown fences: {\\\"score\\\": <1-10 integer>, \\\"reason\\\": \\\"<one sentence>\\\"}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "d907f5aa-6cf0-4fe6-99ed-5d93ef623512",
      "name": "Score Lead vs ICP (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1792,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the Claude scoring response and attach it to the lead item\nconst items = $input.all();\nreturn items.map(item => {\n  let parsed = { score: 0, reason: 'Parse failed' };\n  try {\n    const raw = item.json.content?.[0]?.text ?? '{}';\n    const cleaned = raw.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    // leave default on failure, route to error branch downstream\n  }\n  return {\n    json: {\n      ...item.json,\n      leadScore: parsed.score,\n      scoreReason: parsed.reason\n    }\n  };\n});"
      },
      "id": "127f6f5c-0b48-4644-93b1-173a4501cb8c",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
