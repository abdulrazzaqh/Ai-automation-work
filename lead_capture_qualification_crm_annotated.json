    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/nurture-sequence",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "http_warm",
      "name": "6c. Send to Workflow 2 (Nurture)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
      ]
    },
    {
