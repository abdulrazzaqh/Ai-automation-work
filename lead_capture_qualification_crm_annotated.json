          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "lead-notifications"
        },
        "text": "=New lead logged: {{ $json.name }} ({{ $json.score }}) — {{ $json.summary }} | {{ $json.phone }} | {{ $json.email }}",
        "otherOptions": {}
      },
      "id": "slack_internal",
      "name": "9. Internal Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
