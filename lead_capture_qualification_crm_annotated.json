    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_WHATSAPP_PHONE_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "textBody": "=Thanks {{ $json.name }}, I'm matching properties in {{ $json.location }} for your budget ({{ $json.budget }}) — here's what's available now: [link]",
        "options": {}
      },
      "id": "whatsapp_reply",
      "name": "8. Instant Auto-Reply (WhatsApp)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        460,
